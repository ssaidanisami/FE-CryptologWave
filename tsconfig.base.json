{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@fe-cryptolog-wave/data-access": [
        "./libs/employee/data-access/src/index.ts"
      ],
      "@fe-cryptolog-wave/ui": ["./libs/employee/ui/src/index.ts"],
      "@fe-cryptolog-wave/feature-list": [
        "./libs/employee/feature-list/src/index.ts"
      ],
      "@fe-cryptolog-wave/feature-detail": [
        "./libs/employee/feature-detail/src/index.ts"
      ],
      "@fe-cryptolog-wave/shared-ui": ["./libs/shared/ui/src/index.ts"],
      "@fe-cryptolog-wave/shared-utils": ["./libs/shared/utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
